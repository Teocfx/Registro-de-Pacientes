openapi: 3.0.0
info:
  title: API Registro de Pacientes
  description: API para gerenciamento de pacientes, agendamentos e controle de ponto. FPB A3. PABLO RAMON
  version: 1.0.0
## Documentação da API
## Arquivo Swagger disponível em:
## /docs/swagger.yaml
##Para visualizar:
##https://editor.swagger.io/
##servers:
## - url: http://localhost:3000
## imagem: colocar uma a foto no github.

# GET PACIENTE
  /pacientes:
    get:
      summary: Listar todos os pacientes
      responses:
        '200':
          description: Lista de pacientes
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Paciente'

    post:
      summary: Criar novo paciente
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PacienteInput'
      responses:
        '201':
          description: Paciente criado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Paciente'

  /pacientes/{id}:
    get:
      summary: Buscar paciente por ID
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Paciente encontrado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Paciente'
        '404':
          description: Não encontrado

    put:
      summary: Atualizar paciente
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PacienteInput'
      responses:
        '200':
          description: Atualizado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Paciente'

    delete:
      summary: Deletar paciente
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Removido
# GET AGENDAMENTOOOS
  /agendamentos:
    get:
      summary: Listar agendamentos
      responses:
        '200':
          description: Lista de agendamentos
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Agendamento'

    post:
      summary: Criar agendamento
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AgendamentoInput'
      responses:
        '201':
          description: Agendamento criado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agendamento'

  /agendamentos/{id}:
    get:
      summary: Buscar agendamento por ID
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Agendamento encontrado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agendamento'

    put:
      summary: Atualizar agendamento
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AgendamentoInput'
      responses:
        '200':
          description: Atualizado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Agendamento'

    delete:
      summary: Deletar agendamento
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Removido

# GET CONTROLE DE PONTOS!
  /ponto:
    get:
      summary: Listar registros de ponto
      responses:
        '200':
          description: Lista de registros
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Ponto'

    post:
      summary: Registrar ponto
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PontoInput'
      responses:
        '201':
          description: Registro criado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ponto'

  /ponto/{id}:
    get:
      summary: Buscar registro de ponto por ID
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Registro encontrado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Ponto'

    delete:
      summary: Deletar registro de ponto
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: Removido

components:
  schemas:

    Paciente:
      type: object
      properties:
        id:
          type: integer
          example: 1
        nome:
          type: string
          example: João Silva
        idade:
          type: integer
          example: 30

    PacienteInput:
      type: object
      required:
        - nome
        - idade
      properties:
        nome:
          type: string
          example: Maria Souza
        idade:
          type: integer
          example: 25

    Agendamento:
      type: object
      properties:
        id:
          type: integer
        pacienteId:
          type: integer
        data:
          type: string
          example: "2026-04-10"
        horario:
          type: string
          example: "14:00"

    AgendamentoInput:
      type: object
      required:
        - pacienteId
        - data
        - horario
      properties:
        pacienteId:
          type: integer
          example: 1
        data:
          type: string
          example: "2026-04-10"
        horario:
          type: string
          example: "14:00"

    Ponto:
      type: object
      properties:
        id:
          type: integer
        funcionario:
          type: string
        horario:
          type: string
          example: "08:00"

    PontoInput:
      type: object
      required:
        - funcionario
        - horario
      properties:
        funcionario:
          type: string
          example: João
        horario:
          type: string
          example: "08:00"
